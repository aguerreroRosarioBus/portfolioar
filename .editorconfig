root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{py,pyw}]
indent_size = 4

[*.{html,css,scss,js,jsx,ts,tsx}]
indent_size = 2

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[Dockerfile]
indent_size = 4

[*.cfg]
indent_size = 4

[*.ini]
indent_size = 4

[*.txt]
indent_size = 4